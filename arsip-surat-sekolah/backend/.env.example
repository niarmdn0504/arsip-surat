# ==========================================
# ARSIP SURAT SEKOLAH - Environment Variables
# Salin file ini ke .env lalu isi nilainya
# ==========================================

# Supabase - ambil dari Settings > API di dashboard Supabase
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxx
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxx

# JWT Secret - buat password acak panjang, minimal 32 karakter
# Generator: https://www.uuidgenerator.net/ atau ketik sembarang
JWT_SECRET=ganti_dengan_string_acak_panjang_minimal_32_karakter_ini

# Server
PORT=3000
NODE_ENV=development

# URL Frontend yang diizinkan (pisah dengan koma jika lebih dari 1)
# Development:
FRONTEND_URL=http://localhost:3000,http://localhost:5500,http://127.0.0.1:5500
# Production (ganti dengan URL Railway/Render Anda):
# FRONTEND_URL=https://nama-project.up.railway.app
